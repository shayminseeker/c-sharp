Console.WriteLine("What was your grade on this test? (0-100)");
string gradeStr = Console.ReadLine()!;
int grade;
int.TryParse(gradeStr, out grade);

string lettergrade;
if (grade <= 59)
{
    lettergrade = "F";
    Console.WriteLine("A score of " + grade + " Represents a letter grade of " + lettergrade);
} else if (grade <= 69 && grade >= 60)
{
    lettergrade = "D";
    Console.WriteLine("A score of " + grade + " Represents a letter grade of " + lettergrade);

}else if (grade <= 79 && grade >= 70)
{
    lettergrade = "C";
    Console.WriteLine("A score of " + grade + " Represents a letter grade of " + lettergrade);

} else if (grade <= 89 && grade >= 80)
{
    lettergrade = "B";
    Console.WriteLine("A score of " + grade + " Represents a letter grade of " + lettergrade);

}else if (grade <= 100 && grade >= 90)
{

    lettergrade = "A";
    Console.WriteLine("A score of " + grade + " Represents a letter grade of " + lettergrade);
} else
{
    Console.WriteLine("Invalid Input");
}

