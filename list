//Sum of Elements
int[] inputArray;
inputArray = new int[5];
int sum = 0;
for(int i = 0; i < 5; i++)
{
    Console.WriteLine("Give me a number");
    string arrayNumStr = Console.ReadLine()!;
    int arrayNum;
    int.TryParse(arrayNumStr, out arrayNum);
    inputArray[i] = arrayNum;
   


}
foreach(int num in inputArray)
    {
        
        sum += num;
        
    }
Console.WriteLine(sum);
