//using classes;



Car Ford1 = new Car(2012,"Ford", "Mustang");
Car Chev2 = new Car(2025,"Chevrolet", "Camaro");
Truck truck3 = new Truck(2025, "Ford", "Raptor", 22 );

Inventory inventory1 = new Inventory("Lucas' SuperCars",[Ford1,Chev2,truck3]);



void PrintMenu()
{
    Console.WriteLine("1. View Inventory");
    Console.WriteLine("2. Add a Vehicle");
    Console.WriteLine("3. Remove a Vehicle");
    Console.WriteLine("4. Quit");
}

int GetUserInput()
{
    while (true)
    {
        Console.Write("Select an option from the menu: ");
        string? userInputStr = Console.ReadLine();
        if (int.TryParse(userInputStr, out int userInput))
            return userInput;
        Console.WriteLine("Invalid input. Please enter a number.");
    }
}
void HandleUserInput(int userInput)
{
    switch (userInput)
    {
        case 1:
        inventory1.getInventoryString();
        break;

        case 2:
        Console.WriteLine("Enter a Year");
        string? newVehicleYear = Console.ReadLine();
        int vehicleYear;
        int.TryParse(newVehicleYear, out vehicleYear);
        Console.WriteLine("Enter a Make");
        string? newVehicleMake = Console.ReadLine();
        Console.WriteLine("Enter a Model");
        string? newVehicleModel = Console.ReadLine();
        Console.WriteLine("Is this car a truck?");
        string isTruck = Console.ReadLine();
        if(isTruck == "Yes" && isTruck == "yes")
            {
                Console.WriteLine("Whats its bed length?");
                string newTruckLength= Console.ReadLine();
                int truckLength;
                int.TryParse(newTruckLength, out truckLength);
                Truck newTruck = new Truck(vehicleYear,newVehicleMake,newVehicleModel,truckLength);
                inventory1.addCar(newTruck);
                
            }
            else
            {
                // int currentLength = inventory1.generateId();
                // // string idCode = newVehicleMake + currentLength;
                Car newCar = new Car(vehicleYear,newVehicleMake,newVehicleModel);
                inventory1.addCar(newCar);
            }

        
        
        break;
    
        case 3:
        Console.WriteLine("Which vehicle would you like to remove?");
        string vehicleToRemove = Console.ReadLine();
        int indexToRemove;
         bool isInt = int.TryParse(vehicleToRemove, out indexToRemove);
         if (isInt)
            {
                inventory1.removeCar(indexToRemove);
            }
         

        
        break;

        default:
        break;


    }
}





// Main loop
while (true)
{
    PrintMenu();
    int userInput = GetUserInput();
    if (userInput == 4) // Quit
        break;
    HandleUserInput(userInput);
}
