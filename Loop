//Simple Interest
Console.WriteLine("Simplem Interest Calculation");
int principle = 100;
int rate = 5;
int years = 1;
int interest;
while (years < 5)
{
    interest = (principle *rate *years)/ 100;
    years += 1;
    Console.WriteLine("Year " + years + ":" + "$" + interest);
}
//Prime Numbers
Console.WriteLine("Prime Numbers between 2 and 30:");
for (int num = 2; num < 30; num++)
{
    
    bool isPrime = true;
    for(int i = 2 ; i < num/2; i++)
    {
       
        if(num % i == 0)
        
        {
            isPrime = false;
            break;
        }
        
        
    }
    if (isPrime == true)
    {
        Console.WriteLine(num);
    }

}
